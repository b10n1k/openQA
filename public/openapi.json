{
  "openapi": "3.0.3",
  "info": { "version": "1.0", "title": "OpenQA API" },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/job_settings/jobs": {
      "get": {
        "summary": "Filters jobs based on a single setting key/value pair.",
        "operationId": "apiv1_get_jobs_for_job_settings",
        "x-mojo-to": "job_settings#jobs",
        "parameters": [
  {
    "name": "key",
    "in": "query",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^[\\w\\*]+$"
    }
  },
  {
    "name": "list_value",
    "in": "query",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^\\w+$"
    }
  }
],
        "responses": {
          "200": {
            "description": "A successful response with info.",
            "content": {
  "application/json": {
    "schema": {
      "type": "object",
      "properties": {
        "key": {"type": "string"},
        "list_value": {"type": "string"}
      }
    }
  }
}
          }
        }
      }
    }
  }
}